-- luacheck configuration (CI runs `luacheck .`). WoW's Lua is 5.1 with the client API as globals.
std = "lua51"
max_line_length = 160
codes = true

exclude_files = {
	"Libs/",
	"Data/Plans/", -- generated by tools/gen_plans.lua (data, long lines)
	"Data/Spawns/", -- generated by tools/gen_spawns.lua (data, long lines)
	".release/",
	".luarocks/",
	".lua/",
	"tests/wowmock.lua", -- defines the fake client API on purpose
	"tests/vendor/", -- wow-ui-harness, vendored (tools/sync_harness.sh); linted in its own repository
}

ignore = {
	"212/self", -- unused self in methods
	"212/_.*", -- unused arguments starting with _
	"432/self", -- shadowing self in closures
}

-- Globals Dungeon Planner defines (docs/API.md lists them).
globals = {
	"DungeonPlanner",
	"DungeonPlannerDB",
	"DungeonPlanner_Binding",
	"DungeonPlanner_OnAddonCompartmentClick",
	"BINDING_HEADER_DUNGEONPLANNER",
	"BINDING_NAME_DUNGEONPLANNER_TOGGLE",
	"BINDING_NAME_DUNGEONPLANNER_MAP",
	"BINDING_NAME_DUNGEONPLANNER_NEXT_PULL",
	"BINDING_NAME_DUNGEONPLANNER_PREVIOUS_PULL",
	"BINDING_NAME_DUNGEONPLANNER_BOSS_KILLED",
	"BINDING_NAME_DUNGEONPLANNER_RUN_MODE",
	"BINDING_NAME_DUNGEONPLANNER_SHARE_GROUP",
	"UISpecialFrames",
}

