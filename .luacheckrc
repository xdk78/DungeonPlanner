files["tests/"] = {
	globals = { "_G" },
	read_globals = { "arg", "LibStub", "DungeonPlannerMainFrame" },
	allow_defined_top = true,
}

files["tools/"] = {
	read_globals = { "arg" },
	max_line_length = false,
}

-- Translation tables keep each string on one line.
files["Locales/"] = { max_line_length = false }
