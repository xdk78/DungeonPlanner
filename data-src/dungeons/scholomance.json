  {
   "boss": "p4",
   "text": "Summon him with the Blood of the Innocents at the brazier; he fears and flies, so bring a tank who handles his phase swap."
  },
  {
   "boss": "p5",
   "text": "She casts illusions; ignore the copies and only kill the real one (the one you target first)."
  },
  {
   "boss": "p6",
   "text": "Big bone beast with a wide cleave; tank him away from adds."
  },
  {
   "boss": "p9",
   "text": "Caster with curses and healing; interrupt her heal and dispel the curse."
  },
  {
   "boss": "p16",
   "text": "Frost caster with chilling effects; dispels and interrupts keep the group alive."
  },
  {
   "boss": "p17",
   "text": "Teleports players around; stay alert for his phase effects and kill the adds he summons."
  }
