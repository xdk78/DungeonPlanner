# BigWigs packager (https://github.com/BigWigsMods/packager).
# Libraries are vendored in Libs/ (pinned copies, see docs/LIBRARIES.md), so there are no externals: the zip contains
# exactly what the repository runs in game and what the offline tests load. Refresh them with tools/fetch_libs.sh.
# Left out: everything for development (tests with the vendored test harness, tools, research data, the community
# plan repository, CI, contributor docs). docs/licenses/ ships: the licence notices of imported data and of the
# bundled maps (Media/Maps/Reyes/, docs/licenses/SantiagoReyes-maps.md). The packager matches these entries as shell
# patterns, where "*" also matches "/", so the developer docs are listed one by one ("docs/*.md" would also drop
# docs/licenses/*.md); tests/test_reyesmaps.lua checks it.
package-as: DungeonPlanner

enable-nolib-creation: no

ignore:
  - tests
  - tools
  - data-src
  - docs/API.md
  - docs/ARCHITECTURE.md
  - docs/COMMUNITY-PLANS.md
  - docs/COMPATIBILITY.md
  - docs/CURSEFORGE.md
  - docs/DATA-SOURCES.md
  - docs/LIBRARIES.md
  - docs/RELEASE-NOTES-*.md
  - docs/SHARING-FORMAT.md
  - docs/UI.md
  - docs/research
  - docs/screenshots
  - Media/Logo
  - community-plans
  - .github
  - .luacheckrc
  - .editorconfig
  - .gitattributes
  - .gitignore
  - AGENTS.md
  - CONTRIBUTING.md
  - CODE_OF_CONDUCT.md
  - SECURITY.md

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
